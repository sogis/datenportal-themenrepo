<SO_AGI_DataCatalog_Datasheet_20260523:DatasetSeries ili:tid="o12f40119c51d4d09a99c7d3e842125e4"><SO_AGI_DataCatalog_Datasheet_20260523:identifier>ch.so.staatssteuerertraege_gemeinden</SO_AGI_DataCatalog_Datasheet_20260523:identifier><SO_AGI_DataCatalog_Datasheet_20260523:title>Staatssteuererträge (Kalenderjahr) natürliche und juristische Personen nach Gemeinde Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:title><SO_AGI_DataCatalog_Datasheet_20260523:description>Erträge der Staatssteuer (Kantonssteuer) für das Kalenderjahr (KJ) 2025, aufgeteilt nach natürlichen Personen (NP) und juristischen Personen (JP) sowie Total, pro Gemeinde (Gemeindestand 2026, 104 Gemeinden) und für den Kanton Solothurn gesamthaft. Werte in Tausend Franken (TCHF), gerundet</SO_AGI_DataCatalog_Datasheet_20260523:description><SO_AGI_DataCatalog_Datasheet_20260523:accessLevel>open</SO_AGI_DataCatalog_Datasheet_20260523:accessLevel><SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus>published</SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus><SO_AGI_DataCatalog_Datasheet_20260523:creatorRef>ch.so.ksta</SO_AGI_DataCatalog_Datasheet_20260523:creatorRef><SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Base_20260529:ContactPoint><SO_AGI_DataCatalog_Base_20260529:name>Steueramt</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:organizationUnit>Steueramt Kanton Solothurn</SO_AGI_DataCatalog_Base_20260529:organizationUnit><SO_AGI_DataCatalog_Base_20260529:email>mailto:steueramt.so@fd.so.ch</SO_AGI_DataCatalog_Base_20260529:email><SO_AGI_DataCatalog_Base_20260529:phone>032 627 87 87</SO_AGI_DataCatalog_Base_20260529:phone><SO_AGI_DataCatalog_Base_20260529:url>https://so.ch/verwaltung/finanzdepartement/steueramt/</SO_AGI_DataCatalog_Base_20260529:url></SO_AGI_DataCatalog_Base_20260529:ContactPoint></SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Datasheet_20260523:themes>Finanzen</SO_AGI_DataCatalog_Datasheet_2026