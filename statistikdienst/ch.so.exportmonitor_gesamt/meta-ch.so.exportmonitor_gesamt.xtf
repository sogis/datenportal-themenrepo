<SO_AGI_DataCatalog_Datasheet_20260523:Metadata ili:bid="b19c23de428a14ab2bf8531837dc57af6">
<SO_AGI_DataCatalog_Datasheet_20260523:Dataset ili:tid="obd8e679eb15945dabd1953bd28a1b212"><SO_AGI_DataCatalog_Datasheet_20260523:identifier>ch.so.exportmonitor_gesamt</SO_AGI_DataCatalog_Datasheet_20260523:identifier><SO_AGI_DataCatalog_Datasheet_20260523:title>Exportmonitor: Monatliche Exporte Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:title><SO_AGI_DataCatalog_Datasheet_20260523:description>Monatliche Gesamtexporte des Kantons Solothurn im Vergleich zum Vorjahresmonat. Datengrundlage: Aussenhandelsstatistik des Bundesamts für Zoll und Grenzsicherheit (BAZG), Exporte des Kantons Solothurn, Total 2 (Gesamttotal, inkl. Edelmetalle, Edel- und Schmucksteine sowie Kunstgegenstände und Antiquitäten), nominal in Mio. CHF. Abgedeckt sind die Berichtsmonate Januar 2025 bis Juni 2026, jeweils im Vergleich zum gleichen Monat des Vorjahres (Vorjahreswerte ab Januar 2024). Die Werte für 2026 beruhen auf provisorischen BAZG-Daten und können revidiert werden. Exportwerte auf 0.1 Mio. CHF gerundet; die Veränderung in % ist aus den ungerundeten Werten berechnet und kann daher geringfügig von einer Berechnung aus den gerundeten Werten abweichen. Zweck: Monitoring der Exportentwicklung im Kanton Solothurn (Exportmonitor).</SO_AGI_DataCatalog_Datasheet_20260523:description><SO_AGI_DataCatalog_Datasheet_20260523:accessLevel>open</SO_AGI_DataCatalog_Datasheet_20260523:accessLevel><SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus>published</SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus><SO_AGI_DataCatalog_Datasheet_20260523:creatorRef>ch.so.afin</SO_AGI_DataCatalog_Datasheet_20260523:creatorRef><SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Base_20260529:ContactPoint><SO_AGI_DataCatalog_Base_20260529:name>Patrick Balles, Statistik, Amt für Finanzen, Kanton Solothurn</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:email>mailto:statistik@fd.so.ch</SO_AGI_DataCatalog_Base_20260529:email></SO_AGI_DataCatalog_Base_20260529:ContactPoint></SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Datasheet_20260523:themes>Handel</SO_AGI_DataCatalog_Datasheet_20260523:themes><SO_AGI_DataCatalog_Datasheet_20260523:modified>2026-06-30</SO_AGI_DataCatalog_Datasheet_20260523:modified><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>jahr</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Berichtsjahr</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>monat</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Berichtsmonat (1–12)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>monat_name</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Monatsname</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_