<SO_AGI_DataCatalog_Datasheet_20260523:Metadata ili:bid="b1ebeb144091a482b80590a1519d3f213">
<SO_AGI_DataCatalog_Datasheet_20260523:Dataset ili:tid="o9cfd24480c924a3e89be4c7f5fbce9bb"><SO_AGI_DataCatalog_Datasheet_20260523:identifier>ch.so.finanzkennzahlen</SO_AGI_DataCatalog_Datasheet_20260523:identifier><SO_AGI_DataCatalog_Datasheet_20260523:title>Finanzkennzahlen Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:title><SO_AGI_DataCatalog_Datasheet_20260523:description>Zentrale Finanzkennzahlen des Kantons Solothurn aus der Staatsrechnung: Ergebnisse der Erfolgsrechnung, Cash-Flow, Nettoinvestitionen, Finanzierungsergebnis und Selbstfinanzierungsgrad. Der Datensatz macht die Entwicklung der kantonalen Finanzlage über mehrere Jahre nachvollziehbar und entspricht den im Geschäftsbericht publizierten Werten.</SO_AGI_DataCatalog_Datasheet_20260523:description><SO_AGI_DataCatalog_Datasheet_20260523:accessLevel>open</SO_AGI_DataCatalog_Datasheet_20260523:accessLevel><SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus>published</SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus><SO_AGI_DataCatalog_Datasheet_20260523:creatorRef>ch.so.afin</SO_AGI_DataCatalog_Datasheet_20260523:creatorRef><SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Base_20260529:ContactPoint><SO_AGI_DataCatalog_Base_20260529:name>Amt für Finanzen (AFIN)</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:organizationUnit>Finanzdepartement</SO_AGI_DataCatalog_Base_20260529:organizationUnit><SO_AGI_DataCatalog_Base_20260529:email>mailto:afin@fd.so.ch</SO_AGI_DataCatalog_Base_20260529:email></SO_AGI_DataCatalog_Base_20260529:ContactPoint></SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Datasheet_20260523:themes>Finanzen</SO_AGI_DataCatalog_Datasheet_20260523:themes><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Finanzkennzahlen</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Staatsrechnung</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Erfolgsrechnung</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gesamtergebnis</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Cash-Flow</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Nettoinvestitionen</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Finanzierungsergebnis</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Selbstfinanzierungsgrad</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Kantonsfinanzen</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>HRM2</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity>annually</SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity><SO_AGI_DataCatalog_Datasheet_20260523:modified>2025-12-31</SO_AGI_DataCatalog_Datasheet_20260523:modified><SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage><SO_AGI_DataCatalog_Base_20260529:startDate>2018-01-01</SO_AGI_DataCatalog_Base_20260529:startDate><SO_AGI_DataCatalog_Base_20260529:endDate>2025-12-31</SO_AGI_DataCatalog_Base_20260529:endDate></SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage></SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod>Werte aus der Finanzbuchhaltung des Kantons Solothurn, auf ganze Franken gerundet. Der Datensatz enthält nur Werte der Staatsrechnung (Rechnung). Die Staatsrechnung wird seit 2012 nach HRM2 erstellt, von der Kantonalen Finanzkontrolle geprüft und vom Kantonsrat genehmigt.

Berechnung der einzelnen Kennzahlen:
K1 Betriebsergebnis + Finanzergebnis.
K2 Wertberichtigungen auf dem Finanzvermögen sowie ausserordentlicher Aufwand und Ertrag.
K3 K1 + K2.
K4 K3 – Abschreibung Bilanzfehlbetrag PKSO (konstant 27'290'829 Franken pro Jahr).
K5 K1 + Abschreibungen auf dem Verwaltungsvermögen (ohne PKSO-Abschreibung).
K6 Investitionsausgaben (Kontengruppe 5) – Investitionseinnahmen (Kontengruppe 6).
K7 K5 – K6.
K8 K5 ÷ K6 × 100.

Geschäftsbericht: Kap. III 1 «Das Rechnungsergebnis in Kürze» und Kap. III 1.3 «Finanzkennzahlen».</SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>jahr</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>Integer</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Erfassungsjahr der Staatsrechnung (2018–2025)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>kennzahl_id</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>Text</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Schlüssel der Kennzahl (K1–K8)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>kennzahl</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>Text</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Bezeichnung der Kennzahl</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>art</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>Text</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Art der Werte, konstant «RE» = Rechnung (Staatsrechnung)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>wert</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Wert der Kennzahl in ganzen Franken oder ganzen Prozent</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:unit>CHF oder Prozent</SO_AGI_DataCatalog_Base_20260529:unit><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>einheit</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>Text</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Einheit des Werts («CHF» oder «Prozent»)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:model>SO_Finanzkennzahlen_20261016</SO_AGI_DataCatalog_Datasheet_20260523:model><SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom>ab 2018</SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom><SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData>Keine.</SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData></SO_AGI_DataCatalog_Datasheet_20260523:Dataset>
