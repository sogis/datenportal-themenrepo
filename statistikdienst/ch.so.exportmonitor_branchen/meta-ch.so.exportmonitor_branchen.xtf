<?xml version="1.0" encoding="UTF-8" standalone="no"?><ili:transfer xmlns:ili="http://www.interlis.ch/xtf/2.4/INTERLIS" xmlns:SO_AGI_DataCatalog_Base_20260529="http://www.interlis.ch/xtf/2.4/SO_AGI_DataCatalog_Base_20260529" xmlns:SO_AGI_DataCatalog_Datasheet_20260523="http://www.interlis.ch/xtf/2.4/SO_AGI_DataCatalog_Datasheet_20260523" xmlns:geom="http://www.interlis.ch/geometry/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
<ili:headersection><ili:models><ili:model>SO_AGI_DataCatalog_Base_20260529</ili:model><ili:model>SO_AGI_DataCatalog_Datasheet_20260523</ili:model></ili:models><ili:sender>datasheet-mcp</ili:sender></ili:headersection>
