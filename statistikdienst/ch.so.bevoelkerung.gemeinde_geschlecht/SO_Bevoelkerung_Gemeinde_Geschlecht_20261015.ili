INTERLIS 2.4;

MODEL SO_Bevoelkerung_Gemeinde_Geschlecht_20261015 (de) AT "https://geo.so.ch/models/SO_Bevoelkerung_Gemeinde_Geschlecht_20261015" VERSION "2026-10-15" =
  TOPIC Data =
    OID AS INTERLIS.ANYOID;
    CLASS Observation =
      BFS_Nr : MANDATORY 1 .. 9999;
      Gemeinde : MANDATORY TEXT*100;
      Bezirk : MANDATORY TEXT*60;
      SchweizerInnen_Weiblich : MANDATORY 0 .. 999999;
      AuslaenderInnen_Weiblich : MANDATORY 0 .. 999999;
      SchweizerInnen_Maennlich : MANDATORY 0 .. 999999;
