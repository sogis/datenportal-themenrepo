      Total_SchweizerInnen : MANDATORY 0 .. 999999;
      Total_AuslaenderInnen : MANDATORY 0 .. 999999;
      Total_Maennlich : MANDATORY 0 .. 999999;
      Total_Weiblich : MANDATORY 0 .. 999999;
      Total : MANDATORY 0 .. 999999;
    END Observation;
    CONSTRAINTS OF SO_Bevoelkerung_Gemeinde_Geschlecht_20261015.Data.Observation =
      UNIQUE UniqueBfsNr: BFS_Nr;
    END;

  END Data;
END SO_Bevoelkerung_Gemeinde_Geschlecht_20261015.
