<SO_AGI_DataCatalog_Datasheet_20260523:Metadata ili:bid="bf71791a9be5d48bd9215ef3dca6ef85d">
<SO_AGI_DataCatalog_Datasheet_20260523:DatasetSeries ili:tid="o3e5e6f72dcc44b66a2667a62f6a33d99"><SO_AGI_DataCatalog_Datasheet_20260523:identifier>ch.so.hotellerie_herkunft</SO_AGI_DataCatalog_Datasheet_20260523:identifier><SO_AGI_DataCatalog_Datasheet_20260523:title>Hotellerie: Ankünfte und Logiernächte nach Herkunftsland Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:title><SO_AGI_DataCatalog_Datasheet_20260523:description>Ankünfte und Logiernächte in den geöffneten Hotel- und Kurbetrieben des Kantons Solothurn nach Herkunftsland der Gäste (Schweiz, Ausland total und rund 70 Länder bzw. Ländergruppen), ergänzt mit dem Anteil an allen Logiernächten und der durchschnittlichen Aufenthaltsdauer. Zweck: Beobachtung der touristischen Nachfrage und der wichtigsten Herkunftsmärkte; Grundlage für Tourismus- und Standortförderung sowie die Publikation «Solothurn in Zahlen». Beispiel: 2025 wurden 426’680 Logiernächte gezählt, davon 59,5 % von Gästen aus der Schweiz; wichtigstes ausländisches Herkunftsland ist Deutschland (58’661 Logiernächte). Die Daten stammen vom Bundesamt für Statistik (BFS) und wurden vom Statistikdienst, Amt für Finanzen Kanton Solothurn für den Kanton Solothurn aufbereitet.</SO_AGI_DataCatalog_Datasheet_20260523:description><SO_AGI_DataCatalog_Datasheet_20260523:accessLevel>open</SO_AGI_DataCatalog_Datasheet_20260523:accessLevel><SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus>published</SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus><SO_AGI_DataCatalog_Datasheet_20260523:creatorRef>ch.bfs</SO_AGI_DataCatalog_Datasheet_20260523:creatorRef><SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Base_20260529:ContactPoint><SO_AGI_DataCatalog_Base_20260529:name>Statistikdienst</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:organizationUnit>Amt für Finanzen Kanton Solothurn</SO_AGI_DataCatalog_Base_20260529:organizationUnit><SO_AGI_DataCatalog_Base_20260529:email>mailto:statistik@fd.so.ch</SO_AGI_DataCatalog_Base_20260529:email></SO_AGI_DataCatalog_Base_20260529:ContactPoint></SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Datasheet_20260523:themes>Tourismus</SO_AGI_DataCatalog_Datasheet_20260523:themes><SO_AGI_DataCatalog_Datasheet_20260523:themes>Volkswirtschaft</SO_AGI_DataCatalog_Datasheet_20260523:themes><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Tourismus</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Hotellerie</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Logiernächte</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Ankünfte</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Übernachtungen</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Herkunftsland</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gäste</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Aufenthaltsdauer</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Beherbergung</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>HESTA</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>BFS</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity>annually</SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity><SO_AGI_DataCatalog_Datasheet_20260523:modified>2026-10-02</SO_AGI_DataCatalog_Datasheet_20260523:modified><SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage><SO_AGI_DataCatalog_Base_20260529:startDate>2025-01-01</SO_AGI_DataCatalog_Base_20260529:startDate><SO_AGI_DataCatalog_Base_20260529:endDate>2025-12-31</SO_AGI_DataCatalog_Base_20260529:endDate></SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage></SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod>Quelle: BFS, Beherbergungsstatistik (HESTA), STAT-TAB px-x-1003020000_102 «Hotellerie: Ankünfte und Logiernächte der geöffneten Betriebe nach Jahr, Monat, Kanton, Herkunftsland und Indikator» (Excel-Export). Erhebung: monatliche Erhebung bei den Hotel- und Kurbetrieben; geöffnete Betriebe = im Erhebungsmonat während mindestens einem Tag geöffnet. Herkunftsland = ständiger Wohnsitz der Gäste. Raumbezug: Kantone per 1.1.2026.</SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod><SO_AGI_DataCatalog_Datasheet_20260523:model>SO_Hotellerie_Herkunft_20261015</SO_AGI_DataCatalog_Datasheet_20260523:model><SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom>ab 2005 beim BFS verfügbar (HESTA in der heutigen Form); im aktuellen Datensatz nur 2025 – Neuexport aller Jahre vorgesehen.</SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom><SO_AGI_DataCatalog_Datasheet_20260523:furtherUses>Publikation «Solothurn in Zahlen» (Rubrik Tourismus, Logiernächte nach Herkunftsland).</SO_AGI_DataCatalog_Datasheet_20260523:furtherUses><SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData>Keine zusätzlichen Datenquellen.</SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData><SO_AGI_DataCatalog_Datasheet_20260523:issues><SO_AGI_DataCatalog_Datasheet_20260523:DatasetIssue><SO_AGI_DataCatalog_Datasheet_20260523:identifier>so_hotellerie_herkunft_2025</SO_AGI_DataCatalog_Datasheet_20260523:identifier><SO_AGI_DataCatalog_Datasheet_20260523:issueLabel>2025</SO_AGI_DataCatalog_Datasheet_20260523:issueLabel><SO_AGI_DataCatalog_Datasheet_20260523:isCurrentIssue>true</SO_AGI_DataCatalog_Datasheet_20260523:isCurrentIssue><SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus>published</SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus><SO_AGI_DataCatalog_Datasheet_20260523:modified>2026-10-02</SO_AGI_DataCatalog_Datasheet_20260523:modified><SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage><SO_AGI_DataCatalog_Base_20260529:startDate>2025-01-01</SO_AGI_DataCatalog_Base_20260529:startDate><SO_AGI_DataCatalog_Base_20260529:endDate>2025-12-31</SO_AGI_DataCatalog_Base_20260529:endDate></SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage></SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>jahr</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Kalenderjahr, nur vollständige Jahre.</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>raum_code</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Standort der Betriebe: SO = Kanton Solothurn.</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>raum</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Bezeichnung des Raums.</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>herkunftsland</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Herkunftsland bzw. Ländergruppe der Gäste.</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>herkunft_typ</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Typ der Herkunftsangabe: inland, land.</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>ankuenfte</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Ankünfte (Anzahl).</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>logiernaechte</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Logiernächte (Anzahl).</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>anteil_logiernaechte_prozent</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>DECIMAL</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Anteil an allen Logiernächten desselben Raums und Jahres (Prozent).</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:unit>%</SO_AGI_DataCatalog_Base_20260529:unit><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>aufenthaltsdauer_naechte</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>DECIMAL</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Logiernächte je Ankunft (Nächte; leer bei 0 Ankünften).</SO_AGI_DataCat