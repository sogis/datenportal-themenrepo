<SO_AGI_DataCatalog_Datasheet_20260523:Metadata ili:bid="b3988bbdda376496c94d84eedd0db2834">
<SO_AGI_DataCatalog_Datasheet_20260523:Dataset ili:tid="o208bb177d7514e818203a99c3b60e877"><SO_AGI_DataCatalog_Datasheet_20260523:identifier>ch.so.gws.wohnungen_zimmer</SO_AGI_DataCatalog_Datasheet_20260523:identifier><SO_AGI_DataCatalog_Datasheet_20260523:title>Wohnungen nach Zimmerzahl Gemeinden Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:title><SO_AGI_DataCatalog_Datasheet_20260523:description>Bestand der Wohnungen in den Gemeinden des Kantons Solothurn nach Anzahl Zimmer (1, 2, 3, 4, 5 und mehr) sowie Anzahl Wohnungen in Einfamilienhäusern, mit Bezirkszuordnung. Grundlage ist die Gebäude- und Wohnungsstatistik (GWS) des BFS. Der Datensatz dient als Grundlage für Wohnraum- und Ortsplanung, Wohnungsmarktbeobachtung und Vergleiche zwischen Gemeinden und Bezirken. Interpretationshinweise: – Einfamilienhaus = Gebäude mit ausschliesslicher Wohnnutzung und genau einer Wohnung. Wohngebäude mit Nebennutzung (z. B. Bauernhaus) mit einer Wohnung zählen nicht als Einfamilienhaus. – Erfasst sind bewohnte und unbewohnte Wohnungen. – Eine Zeile pro Gemeinde; Bezirks- und Kantonswerte ergeben sich durch Summieren. – Abweichungen zu aktuellen GWR-Abfragen sind durch Nachführungen nach dem Stichtag möglich. – Gemeindefusion per 01.01.2026: Halten und Oekingen mit Kriegstetten (Bezirk Wasseramt).</SO_AGI_DataCatalog_Datasheet_20260523:description><SO_AGI_DataCatalog_Datasheet_20260523:accessLevel>open</SO_AGI_DataCatalog_Datasheet_20260523:accessLevel><SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus>published</SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus><SO_AGI_DataCatalog_Datasheet_20260523:creatorRef>ch.so.afin</SO_AGI_DataCatalog_Datasheet_20260523:creatorRef><SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Base_20260529:ContactPoint><SO_AGI_DataCatalog_Base_20260529:name>Amt für Finanzen, Statistikdienst</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:organizationUnit>Statistikdienst</SO_AGI_DataCatalog_Base_20260529:organizationUnit><SO_AGI_DataCatalog_Base_20260529:email>mailto:statistik@fd.so.ch</SO_AGI_DataCatalog_Base_20260529:email></SO_AGI_DataCatalog_Base_20260529:ContactPoint></SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Datasheet_20260523:themes>Bau_und_Wohnungswesen</SO_AGI_DataCatalog_Datasheet_20260523:themes><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Wohnungen</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Wohnungsbestand</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Zimmerzahl</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Einfamilienhaus</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gebäude- und Wohnungsstatistik</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>GWS</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>GWR</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gemeinden</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Bezirke</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity>annually</SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity><SO_AGI_DataCatalog_Datasheet_20260523:modified>2026-10-16</SO_AGI_DataCatalog_Datasheet_20260523:modified><SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage><SO_AGI_DataCatalog_Base_20260529:referenceDate>2025-12-31</SO_AGI_DataCatalog_Base_20260529:referenceDate></SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage></SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod>Registerbasierte Vollerhebung: Die Gebäude- und Wohnungsstatistik (GWS) des Bundesamts für Statistik (BFS) beruht auf dem eidgenössischen Gebäude- und Wohnungsregister (GWR), das von den Gemeinden laufend über Baubewilligungen nachgeführt wird. Erfasst ist der Bestand per Stichtag 31.12. (bestehende Gebäude mit Wohnnutzung und deren Wohnungen). Gemeindestand per 31.12. des Erhebungsjahres; Werte je Gemeinde.
Zimmerzahl: Anzahl Zimmer der Wohnung gemäss GWR (ohne Küche, Bad, WC, Korridore); 5+ = 5 und mehr Zimmer.</SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>jahr</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Erhebungsjahr (Stichtag 31.12.)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>bfs_gemeinde_nr</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>BFS-Gemeindenummer</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>gemeinde</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Gemeindename</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatal