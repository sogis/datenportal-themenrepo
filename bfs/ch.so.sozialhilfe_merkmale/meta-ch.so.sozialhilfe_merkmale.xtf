<SO_AGI_DataCatalog_Datasheet_20260523:Metadata ili:bid="bea637d5c756a4234a850e05e20464141">
<SO_AGI_DataCatalog_Datasheet_20260523:Dataset ili:tid="of8b54ce3d94d41d6b6c5997343f3231e"><SO_AGI_DataCatalog_Datasheet_20260523:identifier>ch.so.sozialhilfe_merkmale</SO_AGI_DataCatalog_Datasheet_20260523:identifier><SO_AGI_DataCatalog_Datasheet_20260523:title>Sozialhilfebeziehende nach Geschlecht, Alter, Zivilstand und Staatsangehörigkeit Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:title><SO_AGI_DataCatalog_Datasheet_20260523:description>Jährliche Zeitreihe der Sozialhilfebeziehenden und der Sozialhilfequote im Kanton Solothurn, gegliedert nach Geschlecht, Altersklasse, Zivilstand und Staatsangehörigkeit (Schweiz / Ausland), inkl. aller Kombinationen und Totale. Zweck: Analyse, welche Bevölkerungsgruppen besonders häufig Sozialhilfe beziehen (z. B. Kinder und Jugendliche, ausländische Personen, Geschiedene) und wie sich dies über die Zeit entwickelt. Die Daten stammen vom Bundesamt für Statistik (BFS) und wurden vom Statistikdienst, Amt für Finanzen Kanton Solothurn für den Kanton Solothurn aufbereitet.</SO_AGI_DataCatalog_Datasheet_20260523:description><SO_AGI_DataCatalog_Datasheet_20260523:accessLevel>open</SO_AGI_DataCatalog_Datasheet_20260523:accessLevel><SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus>published</SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus><SO_AGI_DataCatalog_Datasheet_20260523:creatorRef>ch.bfs</SO_AGI_DataCatalog_Datasheet_20260523:creatorRef><SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Base_20260529:ContactPoint><SO_AGI_DataCatalog_Base_20260529:name>Statistikdienst</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:organizationUnit>Amt für Finanzen Kanton Solothurn</SO_AGI_DataCatalog_Base_20260529:organizationUnit><SO_AGI_DataCatalog_Base_20260529:email>mailto:statistik@fd.so.ch</SO_AGI_DataCatalog_Base_20260529:email></SO_AGI_DataCatalog_Base_20260529:ContactPoint></SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Datasheet_20260523:themes>Bevoelkerung</SO_AGI_DataCatalog_Datasheet_20260523:themes><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Sozialhilfe</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Sozialhilfequote</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Sozialhilfebeziehende</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Alter</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Geschlecht</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Zivilstand</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Staatsangehörigkeit</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Kinder und Jugendliche</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>soziale Sicherheit</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>BFS</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity>annually</SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity><SO_AGI_DataCatalog_Datasheet_20260523:modified>2026-10-02</SO_AGI_DataCatalog_Datasheet_20260523:modified><SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage><SO_AGI_DataCatalog_Base_20260529:startDate>2005-01-01</SO_AGI_DataCatalog_Base_20260529:startDate><SO_AGI_DataCatalog_Base_20260529:endDate>2024-12-31</SO_AGI_DataCatalog_Base_20260529:endDate></SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage></SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod>Quelle: BFS, Sozialhilfeempfängerstatistik (SHS), STAT-TAB px-x-1304030000_121 «WSH: Sozialhilfebeziehende der wirtschaftlichen Sozialhilfe nach Kanton, Geschlecht, Altersklasse, Zivilstand, Staatsangehörigkeit (Kategorie)» (Excel-Export, Kanton Solothurn).
Erhebung und Quotendefinition wie Datensatz «Sozialhilfequote und Sozialhilfebeziehende Kanton Solothurn und Schweiz».</SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>jahr</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Erhebungsjahr (Ganzzahl)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>raum_code</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>SO = Kanton Solothurn</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>raum</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Bezeichnung des Raums (Kanton Solothurn)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>geschlecht</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Total, Mann, Frau, Ohne Angabe des Geschlechts</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>altersklasse</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Total, 0-17, 18-25, 26-35, 36-45, 46-55, 56-64, 65 und mehr Jahre, Ohne Angabe</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>zivilstand</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Total, Ledig, Verheiratet, Verwitwet, Geschieden, Ohne Angabe</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>staatsangehoerigkeit</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Total, Schweiz, Ausland, Ohne Angabe</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>sozialhilfebeziehende</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Personen mit Sozialhilfebezug (Anzahl; leer = unterdrückt)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>false</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>sozialhilfequote_prozent</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>DECIMAL</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Quote der jeweiligen Bevölkerungsgruppe (Prozent; leer = nicht berechnet oder unterdrückt)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:unit>Prozent</SO_AGI_DataCatalog_Base_20260529:unit><SO_AGI_DataCatalog_Base_20260529:mandatory>false</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:model>SO_Sozialhilfe_Merkmale_20261016</SO_AGI_DataCatalog_Datasheet_20260523:model><SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom>ab 2005; Quoten nach Zivilstand erst ab 2011</SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom><SO_AGI_DataCatalog_Datasheet_20260523:furtherUses>Weitere Verwendungen:
Publikation «Solothurn in Zahlen» (Rubrik Soziale Sicherheit, Sozialhilfebeziehende nach Alter und Staatsangehörigkeit).</SO_AGI_DataCatalog_Datasheet_20260523:furtherUses><SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData>Verwendete Hilfsdaten / Herkunft:
