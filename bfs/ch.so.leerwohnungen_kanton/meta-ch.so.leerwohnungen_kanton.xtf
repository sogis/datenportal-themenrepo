bute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>leerwohnungsziffer_prozent</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>DECIMAL</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Leerwohnungsziffer (Prozent)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>basis_wohnungsbestand</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Grundlage des Wohnungsbestands, z.B. GWS2022, StatBL2024, approx. Bestand Vorjahr (Text)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>registerbasiert</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>1 = registerbasierte Erhebung ab 2023 (0/1)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:model>SO_Leerwohnungen_Kanton_20261016</SO_AGI_DataCatalog_Datasheet_20260523:model><SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom>ab 1999 im Datensatz (BFS-Tabelle je-d-09.03.04.03 mit Jahresblättern ab 1999); die Leerwohnungsziffer wird gemäss BFS seit 1985 berechnet.</SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom><SO_AGI_DataCatalog_Datasheet_20260523:furtherUses>Publikation «Solothurn in Zahlen» (Rubrik Wohnen und Haushalte, Entwicklung der Leerwohnungen).</SO_AGI_DataCatalog_Datasheet_20260523:furtherUses><SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData>Keine zusätzlichen Hilfsdaten. Wohnungsbestand und Leerwohnungsziffer stammen unverändert aus der BFS-Tabelle (Basis GWS bzw. StatBL des Vorjahres).</SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData></SO_AGI_DataCatalog_Datasheet_20260523:Dataset>
