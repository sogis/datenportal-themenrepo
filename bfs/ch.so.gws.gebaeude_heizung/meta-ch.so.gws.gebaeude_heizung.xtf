529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Holz</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:unit>Anzahl Gebäude</SO_AGI_DataCatalog_Base_20260529:unit><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>geb_hz_elektrizitaet</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Elektrizität</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:unit>Anzahl Gebäude</SO_AGI_DataCatalog_Base_20260529:unit><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>geb_hz_fernwaerme</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Fernwärme</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:unit>Anzahl Gebäude</SO_AGI_DataCatalog_Base_20260529:unit><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>geb_hz_andere_unbekannt</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>andere, keine oder unbekannt</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:unit>Anzahl Gebäude</SO_AGI_DataCatalog_Base_20260529:unit><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:model>SO_GWS_Gebaeude_Heizung_20261016</SO_AGI_DataCatalog_Datasheet_20260523:model><SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom>Erhebungsjahr 2025 (erster publizierter Jahrgang dieses Datensatzes)</SO_AGI_DataCatalog_Datasheet_20260523:dataAvailableFrom><SO_AGI_DataCatalog_Datasheet_20260523:furtherUses>Weitere Verwendungen:
Grundlage u. a. für Wohnraum-, Orts- und Energieplanung sowie Wohnungsmarktbeobachtung.</SO_AGI_DataCatalog_Datasheet_20260523:furtherUses><SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData>Verwendete Hilfsdaten / Herkunft:
Bezirkszuordnung gemäss Amtlichem Gemeindeverzeichnis der Schweiz (BFS).

Interpretationshinweise:
– Gebäude mit Wärmepumpe werden unabhängig von der Energiequelle als «Wärmepumpe» gezählt (die Energiequelle ist bei Wärmepumpen im GWR oft unbestimmt). Die übrigen Gebäude sind nach Energieträger eingeteilt; «andere, keine oder unbekannt» umfasst u. a. thermische Solaranlagen.
– Heizungsangaben beruhen auf Meldungen ans GWR und können bei älteren Gebäuden veraltet sein.
– Eine Zeile pro Gemeinde; Bezirks- und Kantonswerte ergeben sich durch Summieren.
– Abweichungen zu aktuellen GWR-Abfragen sind durch Nachführungen nach dem Stichtag möglich.
– Gemeindefusion per 01.01.2026: Halten und Oekingen mit Kriegstetten (Bezirk Wasseramt).</SO_AGI_DataCatalog_Datasheet_20260523:auxiliaryData></SO_AGI_DataCatalog_Datasheet_20260523:Dataset>
</SO_AGI_DataCatalog_Datasheet_20260523:Metadata>
