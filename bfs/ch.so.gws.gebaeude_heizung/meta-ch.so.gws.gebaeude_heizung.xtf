<SO_AGI_DataCatalog_Datasheet_20260523:Dataset ili:tid="o2ff0f430ffbc4292b2f6aa47647b1465"><SO_AGI_DataCatalog_Datasheet_20260523:identifier>ch.so.gws.gebaeude_heizung</SO_AGI_DataCatalog_Datasheet_20260523:identifier><SO_AGI_DataCatalog_Datasheet_20260523:title>Gebäude mit Wohnnutzung nach Heizsystem und Energieträger der Hauptheizung Gemeinden Kanton Solothurn</SO_AGI_DataCatalog_Datasheet_20260523:title><SO_AGI_DataCatalog_Datasheet_20260523:description>Bestand der Gebäude mit Wohnnutzung in den Gemeinden des Kantons Solothurn nach Heizsystem und Energieträger der Hauptheizung, mit Bezirkszuordnung. Grundlage ist die Gebäude- und Wohnungsstatistik (GWS) des BFS. Der Datensatz dient als Grundlage für die Energieplanung, das Monitoring des Heizungsersatzes sowie Vergleiche zwischen Gemeinden und Bezirken.</SO_AGI_DataCatalog_Datasheet_20260523:description><SO_AGI_DataCatalog_Datasheet_20260523:accessLevel>open</SO_AGI_DataCatalog_Datasheet_20260523:accessLevel><SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus>published</SO_AGI_DataCatalog_Datasheet_20260523:publicationStatus><SO_AGI_DataCatalog_Datasheet_20260523:creatorRef>ch.so.afin</SO_AGI_DataCatalog_Datasheet_20260523:creatorRef><SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Base_20260529:ContactPoint><SO_AGI_DataCatalog_Base_20260529:name>Amt für Finanzen, Statistikdienst</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:email>mailto:statistik@fd.so.ch</SO_AGI_DataCatalog_Base_20260529:email></SO_AGI_DataCatalog_Base_20260529:ContactPoint></SO_AGI_DataCatalog_Datasheet_20260523:contactPoint><SO_AGI_DataCatalog_Datasheet_20260523:themes>Bau_und_Wohnungswesen</SO_AGI_DataCatalog_Datasheet_20260523:themes><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gebäude</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gebäudebestand</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Heizung</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Energieträger</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Wärmepumpe</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Heizöl</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gas</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Holz</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Fernwärme</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Elektrizität</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gebäude- und Wohnungsstatistik</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>GWS</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>GWR</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Gemeinden</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:keywords>Bezirke</SO_AGI_DataCatalog_Datasheet_20260523:keywords><SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity>annually</SO_AGI_DataCatalog_Datasheet_20260523:accrualPeriodicity><SO_AGI_DataCatalog_Datasheet_20260523:modified>2026-10-16</SO_AGI_DataCatalog_Datasheet_20260523:modified><SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage><SO_AGI_DataCatalog_Base_20260529:referenceDate>2025-12-31</SO_AGI_DataCatalog_Base_20260529:referenceDate></SO_AGI_DataCatalog_Datasheet_20260523:ClosedTemporalCoverage></SO_AGI_DataCatalog_Datasheet_20260523:temporalCoverage><SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod>Registerbasierte Vollerhebung: Die Gebäude- und Wohnungsstatistik (GWS) des Bundesamts für Statistik (BFS) beruht auf dem eidgenössischen Gebäude- und Wohnungsregister (GWR), das von den Gemeinden laufend über Baubewilligungen nachgeführt wird. Erfasst ist der Bestand per Stichtag 31.12. (bestehende Gebäude mit Wohnnutzung und deren Wohnungen). Gemeindestand per 31.12. des Erhebungsjahres; Werte je Gemeinde.
Heizung: massgebend ist die Hauptheizung gemäss GWR (Wärmeerzeuger und Energie-/Wärmequelle).</SO_AGI_DataCatalog_Datasheet_20260523:surveyMethod><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>jahr</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Erhebungsjahr (Stichtag 31.12.)</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>bfs_gemeinde_nr</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>INTEGER</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>BFS-Gemeindenummer</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260529:DatasetAttribute><SO_AGI_DataCatalog_Base_20260529:name>gemeinde</SO_AGI_DataCatalog_Base_20260529:name><SO_AGI_DataCatalog_Base_20260529:dataType>TEXT</SO_AGI_DataCatalog_Base_20260529:dataType><SO_AGI_DataCatalog_Base_20260529:description>Gemeindename</SO_AGI_DataCatalog_Base_20260529:description><SO_AGI_DataCatalog_Base_20260529:mandatory>true</SO_AGI_DataCatalog_Base_20260529:mandatory></SO_AGI_DataCatalog_Base_20260529:DatasetAttribute></SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Datasheet_20260523:attributes><SO_AGI_DataCatalog_Base_20260